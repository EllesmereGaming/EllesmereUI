# Libraries are pulled by the packager via .pkgmeta externals
Libs/
EllesmereUIUnitFrames/Libs/

.release/

# Kiro workspace files
.kiro/
.DS_Store

# Claude Code workspace files
.claude/
CLAUDE.md
CLAUDE_PATTERNS.md

# 12.1 migration working documents (dev-only, never ship)
MIDNIGHT_AURA_MIGRATION.md
MIDNIGHT_MERGE_PLAN.md

# Developer scripts
*.ps1
luac.out

# Python bytecode from .tools scripts and tests
__pycache__/
*.pyc

# A stray working folder: tools of other projects have written to _tools/ here by mistake.
# Never part of the addon.
/_tools/

# .tools is the maintainer's own tooling (generators, local test harnesses): not part of the
# repository. Tracked there is only what the GitHub checks run.
/.tools/*
!/.tools/guardrails.py
!/.tools/extract-locale-keys.sh
!/.tools/tests/
/.tools/tests/*
!/.tools/tests/test_guardrails.py
