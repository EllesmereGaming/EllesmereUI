..\EllesmereUILocales\ptBR_GameNames.lua [AllowLoadTextLocale ptBR]
..\EllesmereUILocales\ruRU_GameNames.lua [AllowLoadTextLocale ruRU]
..\EllesmereUILocales\zhCN_GameNames.lua [AllowLoadTextLocale zhCN]
..\EllesmereUILocales\zhTW_GameNames.lua [AllowLoadTextLocale zhTW]

